-- 🤖 智能 NPC 缓存系统 (按需启停绝对 0 占用版)
-- ==========================================
local CachedNPCs = {}
local npcScanThread = nil

local function StartNPCScanner()
    if npcScanThread then return end
    npcScanThread = task.spawn(function()
        while true do
            if not RayConfig.TargetNPCs then break end

            local tempCache = {}
            local descendants = workspace:GetDescendants()
            
            for i = 1, #descendants do
                -- 如果在扫描中途关闭了开关，立刻打断循环
                if not RayConfig.TargetNPCs then break end

                local obj = descendants[i]
                if obj:IsA("Humanoid") and obj.Health > 0 then
                    local char = obj.Parent
                    if char and char:IsA("Model") and not Players:GetPlayerFromCharacter(char) then
                        table.insert(tempCache, char)
                    end
                end
                
                -- 分帧处理防止瞬间卡顿
                if i % 500 == 0 then
                    RunService.Heartbeat:Wait()
                end
            end
            
            if RayConfig.TargetNPCs then
                CachedNPCs = tempCache
                task.wait(3)
            end
        end
    end)
end

local function StopNPCScanner()
    if npcScanThread then
        task.cancel(npcScanThread) -- 强行销毁后台线程
        npcScanThread = nil
    end
    table.clear(CachedNPCs) -- 清空缓存，释放内存
end

-- ==========================================
-- 🔍 核心寻敌算法 (死锁防抖机制)
-- ==========================================
local function GetActualPart(character, partName)
    local fallbacks = PartMap[partName]
    for _, name in ipairs(fallbacks) do
        local part = character:FindFirstChild(name)
        if part then return part end
    end
    return character:FindFirstChildWhichIsA("BasePart")
end

local function IsVisible(targetPart)
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    params.FilterType = Enum.RaycastFilterType.Exclude
    
    local result = workspace:Raycast(origin, direction, params)
    if result and not result.Instance:IsDescendantOf(targetPart.Parent) then
        return false 
    end
    return true
end

local function IsCurrentTargetValid(screenCenter)
    if CurrentTarget and CurrentTargetPart and CurrentTarget:FindFirstChild("Humanoid") and CurrentTarget.Humanoid.Health > 0 then
        local isPlayerTarget = (Players:GetPlayerFromCharacter(CurrentTarget) ~= nil)
        
        if isPlayerTarget then
            if RayConfig.TeamCheck then
                local tgtPlayer = Players:GetPlayerFromCharacter(CurrentTarget)
                if LocalPlayer.Team and tgtPlayer.Team == LocalPlayer.Team then return false end
            end
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(CurrentTargetPart.Position)
        if onScreen then
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
            if dist <= RayConfig.FOVRadius then
                if RayConfig.WallCheck and not RayConfig.WallBang then
                    if not IsVisible(CurrentTargetPart) then return false end
                end
                return true
            end
        end
    end
    return false
end

RunService.RenderStepped:Connect(function()
    FovFrame.Size = UDim2.fromOffset(RayConfig.FOVRadius * 2, RayConfig.FOVRadius * 2)
    FovStroke.Color = RayConfig.FOVColor
    EspDot.Size = UDim2.fromOffset(RayConfig.DotSize, RayConfig.DotSize)
    EspDot.BackgroundColor3 = RayConfig.DotColor
    TracerLine.BackgroundColor3 = RayConfig.TracerColor

    if not RayConfig.Enabled then 
        FovFrame.Visible = false
        EspDot.Visible = false
        TracerLine.Visible = false
        CurrentTarget = nil
        return 
    end

    FovFrame.Visible = true 
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if not IsCurrentTargetValid(screenCenter) then
        local closestDist = RayConfig.FOVRadius
        local bestTarget = nil
        local bestPart = nil
        
        local function ScanEntities(entityList, isPlayer)
            for _, entity in ipairs(entityList) do
                local character = isPlayer and entity.Character or entity
                if character and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
                    if isPlayer then
                        if entity == LocalPlayer then continue end
                        if RayConfig.TeamCheck and LocalPlayer.Team and entity.Team == LocalPlayer.Team then continue end
                    end
                    
                    local desiredPart = isPlayer and RayConfig.TargetPartPlayer or RayConfig.TargetPartNPC
                    local targetPart = GetActualPart(character, desiredPart)
                    
                    if targetPart then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            if dist < closestDist then
                                if RayConfig.WallCheck and not RayConfig.WallBang then
                                    if not IsVisible(targetPart) then continue end
                                end
                                closestDist = dist
                                bestTarget = character
                                bestPart = targetPart
                            end
                        end
                    end
                end
            end
        end

        if RayConfig.TargetPlayers then ScanEntities(Players:GetPlayers(), true) end
        if RayConfig.TargetNPCs then ScanEntities(CachedNPCs, false) end

        CurrentTarget = bestTarget
        CurrentTargetPart = bestPart
    end

    if RayConfig.ShowESP and CurrentTargetPart then
        local screenPos, onScreen = Camera:WorldToViewportPoint(CurrentTargetPart.Position)
        if onScreen then
            EspDot.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
            EspDot.Visible = true
            
            local targetVector = Vector2.new(screenPos.X, screenPos.Y)
            local distance = (targetVector - screenCenter).Magnitude
            local centerPoint = (targetVector + screenCenter) / 2
            local angle = math.deg(math.atan2(targetVector.Y - screenCenter.Y, targetVector.X - screenCenter.X))
            
            TracerLine.Size = UDim2.new(0, distance, 0, 1.5)
            TracerLine.Position = UDim2.new(0, centerPoint.X, 0, centerPoint.Y)
            TracerLine.Rotation = angle
            TracerLine.Visible = true
        else
            EspDot.Visible = false
            TracerLine.Visible = false
        end
    else
        EspDot.Visible = false
        TracerLine.Visible = false
    end
end)

-- ==========================================
-- ⚡ Delta 专属底层拦截 (动态距离白名单穿墙版)
-- ==========================================
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if RayConfig.Enabled and CurrentTargetPart then
        if method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
            
            local caller = getcallingscript()
            if caller then
                local callerName = caller.Name
                if callerName == "CameraModule" or callerName == "ControlModule" or callerName == "PlayerModule" or callerName == "PlayerScripts" then
                    return oldNamecall(self, ...)
                end
            end

            local origin = (method == "Raycast") and args[1] or args[1].Origin
            local direction = (CurrentTargetPart.Position - origin).Unit
            
            local realDistance = (CurrentTargetPart.Position - origin).Magnitude + 500 
            
            if RayConfig.WallBang then
                if method == "Raycast" then
                    args[1] = origin
                    args[2] = direction * realDistance
                    
                    local wlParams = RaycastParams.new()
                    wlParams.FilterType = Enum.RaycastFilterType.Include
                    wlParams.FilterDescendantsInstances = {CurrentTargetPart.Parent}
                    wlParams.IgnoreWater = true
                    args[3] = wlParams
                    
                elseif method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" then
                    setnamecallmethod("FindPartOnRayWithWhitelist")
                    args[1] = Ray.new(origin, direction * realDistance)
                    args[2] = {CurrentTargetPart.Parent} 
                elseif method == "FindPartOnRayWithWhitelist" then
                    args[1] = Ray.new(origin, direction * realDistance)
                    args[2] = {CurrentTargetPart.Parent}
                end
            else
                if method == "Raycast" then
                    args[2] = direction * realDistance
                else
                    args[1] = Ray.new(origin, direction * realDistance)
                end
            end
            return oldNamecall(self, unpack(args))
        end
    end
    
    return oldNamecall(self, ...)
end))

