-- 丝滑重排逻辑
local function UpdateHUDPositions()
    local currentY = 10
    for _, panel in ipairs(ActivePanels) do
        TweenService:Create(panel.Frame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = UDim2.new(1, -10, 0, currentY)
        }):Play()
        currentY = currentY + panel.Frame.Size.Y.Offset + 10 -- 根据自身高度往下排
    end
end

-- 创建基础面板 (内部元素同样混入乱码命名)
local function CreateHUDPanel(id, defaultText)
    local frame = Instance.new("Frame", HUDGui)
    frame.Name = GenerateGarbledString(16)
    frame.Size = UDim2.fromOffset(80, 30)
    frame.Position = UDim2.new(1, 100, 0, 10) -- 初始在屏幕外右侧，滑入更丝滑
    frame.AnchorPoint = Vector2.new(1, 0)
    frame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    frame.BackgroundTransparency = 0.35 -- 灰色亚克力质感
    frame.ClipsDescendants = true
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 3)

    local label = Instance.new("TextLabel", frame)
    label.Name = GenerateGarbledString(12)
    label.Size = UDim2.new(1, -10, 1, -10)
    label.Position = UDim2.fromOffset(5, 5)
    label.BackgroundTransparency = 1
    label.Text = defaultText
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Center

    local panelData = {Id = id, Frame = frame, Label = label}
    return panelData
end

-- 动态更新文字并自适应尺寸丝滑拉伸
local function UpdateHUDText(panelData, newText, color)
    if not panelData or not panelData.Frame.Parent then return end
    panelData.Label.Text = newText
    if color then panelData.Label.TextColor3 = color end
    
    local textBounds = game:GetService("TextService"):GetTextSize(newText, 12, Enum.Font.GothamMedium, Vector2.new(150, 1000))
    local targetWidth = math.max(80, textBounds.X + 16)
    local targetHeight = math.max(30, textBounds.Y + 10)
    
    if panelData.Frame.Size.Y.Offset ~= targetHeight or panelData.Frame.Size.X.Offset ~= targetWidth then
        TweenService:Create(panelData.Frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(targetWidth, targetHeight)
        }):Play()
        task.delay(0.21, UpdateHUDPositions)
    end
end

-- 开关面板逻辑
local function ToggleHUD(id, state, defaultText)
    if state then
        local p = CreateHUDPanel(id, defaultText)
        table.insert(ActivePanels, p)
        UpdateHUDPositions()
        return p
    else
        for i, p in ipairs(ActivePanels) do
            if p.Id == id then
                table.remove(ActivePanels, i)
                local f = p.Frame
                local tw = TweenService:Create(f, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    Position = UDim2.new(1, 150, 0, f.Position.Y.Offset)
                })
                tw:Play()
                tw.Completed:Connect(function() f:Destroy() end)
                break
            end
        end
        UpdateHUDPositions()
        return nil
    end
end

