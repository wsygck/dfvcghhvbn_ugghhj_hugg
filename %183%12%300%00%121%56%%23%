    TopDivider.Position = UDim2.new(0, 0, 0, TopBarAbsoluteHeight - 1) 
    TopDivider.BackgroundColor3 = StrokeColor 
    TopDivider.BorderSizePixel = 0 
    TopDivider.ZIndex = 5

    local TopBar = Instance.new("Frame", MainFrame)
    TopBar.Size = UDim2.new(1, 0, 0, TopBarAbsoluteHeight) 
    TopBar.BackgroundTransparency = 1
    local TopLayout = Instance.new("UIListLayout", TopBar)
    TopLayout.FillDirection = Enum.FillDirection.Horizontal 
    TopLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local TitleArea = Instance.new("TextLabel", TopBar)
    TitleArea.Size = UDim2.new(0, 120, 1, 0) TitleArea.BackgroundTransparency = 1 TitleArea.Text = Settings.Title or "HAOXIAO" TitleArea.TextColor3 = FontColor TitleArea.Font = Config.Typography.FontType TitleArea.TextSize = Config.Typography.GlobalTextSize

    local SubTitleArea = Instance.new("TextLabel", TopBar)
    SubTitleArea.Size = UDim2.new(0, 140, 1, 0) SubTitleArea.BackgroundTransparency = 1 SubTitleArea.Text = Settings.SubTitle or "v1.0" SubTitleArea.TextColor3 = Config.Typography.DimTextColor SubTitleArea.TextTransparency = Config.Typography.DimTextTransparency SubTitleArea.Font = Config.Typography.FontType SubTitleArea.TextSize = Config.Typography.GlobalTextSize SubTitleArea.TextXAlignment = Enum.TextXAlignment.Left

    local Spacer = Instance.new("Frame", TopBar)
    Spacer.Size = UDim2.new(1, -(120 + 140 + (Config.TopButton.Width * 3)), 1, 0) Spacer.BackgroundTransparency = 1

    local function CreateTopButton(iconText, callback)
