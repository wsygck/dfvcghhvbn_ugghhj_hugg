        local Btn = Instance.new("TextButton", Area) Btn.Size = UDim2.fromOffset(26, 26) Btn.Position = UDim2.fromScale(0.5, 0.5) Btn.AnchorPoint = Vector2.new(0.5, 0.5) Btn.BackgroundColor3 = Config.TopButton.BackgroundColor Btn.BackgroundTransparency = Config.TopButton.BackgroundTransparency Btn.Text = iconText Btn.TextColor3 = Config.TopButton.TextColor Btn.TextSize = Config.Typography.GlobalTextSize Btn.Font = Enum.Font.GothamBold
