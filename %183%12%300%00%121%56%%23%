    -- 最小化按钮
    CreateTopButton("-", function()
        FloatingBtn.Visible = true FloatingBtn.BackgroundTransparency = 1 
        TweenService:Create(FloatingBtn, TweenInfo.new(0.3), {BackgroundTransparency = Config.FloatingButton.BackgroundTransparency}):Play()
        local tw = TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut), { Size = UDim2.fromOffset(0, 0), Position = FloatingBtn.Position })
        tw:Play() tw.Completed:Connect(function() MainFrame.Visible = false end)
    end)

    FloatingBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = true 
        TweenService:Create(FloatingBtn, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
        local targetSize = Window.IsMaximized and UDim2.fromOffset(workspace.CurrentCamera.ViewportSize.X * 0.9, workspace.CurrentCamera.ViewportSize.Y * 0.9) or UDim2.fromOffset(Config.Window.Width, Config.Window.Height)
        local targetPos = Window.IsMaximized and UDim2.fromOffset((workspace.CurrentCamera.ViewportSize.X - targetSize.X.Offset)/2, (workspace.CurrentCamera.ViewportSize.Y - targetSize.Y.Offset)/2) or Config.Window.Position
        local tw = TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut), { Size = targetSize, Position = targetPos })
        tw:Play() tw.Completed:Connect(function() FloatingBtn.Visible = false end)
    end)

    -- 最大化按钮
    local originalSize = MainFrame.Size
    local originalPos = MainFrame.Position
    CreateTopButton("□", function()
        Window.IsMaximized = not Window.IsMaximized
        if Window.IsMaximized then
            originalSize = MainFrame.Size originalPos = MainFrame.Position
