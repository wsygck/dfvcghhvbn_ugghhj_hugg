-- 栏位 1: 全局一键替换
local GlobalTab = Window:AddTab({ Name = "一键全局替换", Icon = "rbxassetid://104508482519186" })

GlobalTab:AddButton({
    Name = "🔄 初始化 (恢复原始动作)",
    Callback = function()
        IsUIUpdating = true
        for state, toggles in pairs(ToggleObjects) do
            for _, toggle in pairs(toggles) do
                if toggle.Value then toggle:SetValue(false) end
            end
        end
        ActiveAnimData = {}
        IsUIUpdating = false
        ApplyAnimations()
    end
})

for _, packName in ipairs(PackOrder) do
    GlobalTab:AddButton({
        Name = "▶ 装备全套: " .. packName,
        Callback = function()
            IsUIUpdating = true
            -- 1. 更新底层数据
            for state, _ in pairs(AnimStateNames) do
                ActiveAnimData[state] = AnimPacks[packName][state]
            end
            
            -- 2. 同步更新所有分栏的 UI 开关状态 (互斥展现)
            for state, toggles in pairs(ToggleObjects) do
                for targetPackName, toggle in pairs(toggles) do
                    if targetPackName == packName then
                        if not toggle.Value then toggle:SetValue(true) end
                    else
                        if toggle.Value then toggle:SetValue(false) end
                    end
                end
            end
            
            IsUIUpdating = false
            ApplyAnimations()
        end
    })
end

-- 栏位 2 ~ N: 独立动作包拆分控制
for _, packName in ipairs(PackOrder) do
    local packData = AnimPacks[packName]
    local PackTab = Window:AddTab({ Name = packName, Icon = "rbxassetid://104508482519186" })
    
    PackTab:AddLabel("单独控制 " .. packName .. " 散件")
    
    for stateKey, stateName in pairs(AnimStateNames) do
        local animIdData = packData[stateKey]
        
        local toggle = PackTab:AddToggle({
            Name = "开启 [" .. stateName .. "] 动作",
            Default = false,
            Callback = function(Value)
                if IsUIUpdating then return end -- 防止全局按钮触发回调死锁
                
                if Value then
                    -- 【互斥逻辑】自动关闭其他动作包中相同部位的开关
                    IsUIUpdating = true
                    for otherPackName, otherToggle in pairs(ToggleObjects[stateKey]) do
                        if otherPackName ~= packName and otherToggle.Value == true then
                            otherToggle:SetValue(false)
                        end
                    end
                    IsUIUpdating = false
                    
                    ActiveAnimData[stateKey] = animIdData
                else
                    if ActiveAnimData[stateKey] == animIdData then
                        ActiveAnimData[stateKey] = nil
                    end
                end
                ApplyAnimations()
            end
        })
        
        ToggleObjects[stateKey][packName] = toggle
    end
end

