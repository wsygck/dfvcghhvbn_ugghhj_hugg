-- 运行时状态
local OriginalAnims = {}
local ActiveAnimData = {} 
local ToggleObjects = { idle = {}, walk = {}, run = {}, jump = {}, fall = {}, climb = {}, swim = {} }
local IsUIUpdating = false -- 防止互斥开关引发无限循环死锁

-- ==========================================
-- ⚙️ 2. 核心渲染与状态管理逻辑
-- ==========================================
local function SaveOriginalAnimations(animateScript)
    if next(OriginalAnims) ~= nil then return end 
    for state, _ in pairs(AnimStateNames) do
        local stateFolder = animateScript:FindFirstChild(state)
        if stateFolder then
            OriginalAnims[state] = {}
            for _, anim in ipairs(stateFolder:GetChildren()) do
                if anim:IsA("Animation") then
                    table.insert(OriginalAnims[state], {Obj = anim, Id = anim.AnimationId})
                end
            end
        end
    end
end

local function ApplyAnimations()
    local char = LocalPlayer.Character
    if not char then return end
    local animateScript = char:FindFirstChild("Animate")
    if not animateScript then return end

    SaveOriginalAnimations(animateScript)

    for state, defaultAnims in pairs(OriginalAnims) do
        local stateFolder = animateScript:FindFirstChild(state)
        if stateFolder then
            local targetData = ActiveAnimData[state]
            local index = 1
            for _, animObj in ipairs(stateFolder:GetChildren()) do
                if animObj:IsA("Animation") then
                    if targetData then
                        animObj.AnimationId = type(targetData) == "table" and targetData[index] or targetData
                    else
                        animObj.AnimationId = defaultAnims[index].Id
                    end
                    index = index + 1
                end
            end
        end
    end

    -- 禁用再启用，触发服务端同步 (确保其他玩家可见)
    animateScript.Disabled = true
    task.wait(0.05)
    animateScript.Disabled = false
end

