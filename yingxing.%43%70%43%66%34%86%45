local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")


if _G.HX_InvisCleanup then
    pcall(_G.HX_InvisCleanup)
end

local trueInvisActive = false
local HeartbeatConnection, SteppedConnection, DieConnection = nil, nil, nil
local OriginalTransparency = {}
local FakeOffset = Vector3.new(0, 50000, 0) 
local RealLocalCFrame = nil
local SavedCameraType = nil

local function CleanUpInvis()
    trueInvisActive = false
    if HeartbeatConnection then HeartbeatConnection:Disconnect() HeartbeatConnection = nil end
    if SteppedConnection then SteppedConnection:Disconnect() SteppedConnection = nil end
    if DieConnection then DieConnection:Disconnect() DieConnection = nil end
    
    pcall(function() RunService:UnbindFromRenderStep("InvisRenderFix") end)
    
    local player = game.Players.LocalPlayer
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and RealLocalCFrame then
            hrp.CFrame = RealLocalCFrame
        end
        
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and OriginalTransparency[part] then
                part.Transparency = OriginalTransparency[part]
                part.CanCollide = true
            elseif part:IsA("Decal") and OriginalTransparency[part] then
                part.Transparency = OriginalTransparency[part]
            end
        end
    end
    
    local cam = workspace.CurrentCamera
    if cam and SavedCameraType then
        cam.CameraType = SavedCameraType
    end
    OriginalTransparency = {}
end

local targetParent = game:GetService("CoreGui")
