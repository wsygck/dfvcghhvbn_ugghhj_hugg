-- ==========================================
-- 隐身开关逻辑绑定
-- ==========================================
RightArea.MouseButton1Click:Connect(function()
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    if not trueInvisActive then
        -- 开启隐身
        trueInvisActive = true
        
        -- UI 动画 (变绿、向右移动)
        TweenService:Create(ToggleBG, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(60, 200, 100)}):Play()
        TweenService:Create(ToggleCircle, TweenInfo.new(0.3), {Position = UDim2.new(1, -16, 0.5, 0)}):Play()
        
        local cam = workspace.CurrentCamera
        if cam then SavedCameraType = cam.CameraType end
        
        OriginalTransparency = {}
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                OriginalTransparency[part] = part.Transparency
                if part.Name ~= "HumanoidRootPart" then part.Transparency = 0.5 end
            elseif part:IsA("Decal") then
                OriginalTransparency[part] = part.Transparency
                part.Transparency = 0.5
            end
        end
        
        RealLocalCFrame = hrp.CFrame
        
        SteppedConnection = RunService.Stepped:Connect(function()
            if not trueInvisActive or not hrp then return end
            -- 传送激变拦截器
            local currentPos = hrp.Position
            local expectedReal = RealLocalCFrame.Position
            local expectedFake = (RealLocalCFrame + FakeOffset).Position
            if (currentPos - expectedReal).Magnitude > 200 and (currentPos - expectedFake).Magnitude > 200 then
                RealLocalCFrame = hrp.CFrame
            end
            hrp.CFrame = RealLocalCFrame
        end)
        
        HeartbeatConnection = RunService.Heartbeat:Connect(function()
            if not trueInvisActive or not hrp then return end
            RealLocalCFrame = hrp.CFrame
            hrp.CFrame = RealLocalCFrame + FakeOffset
        end)
        
        RunService:BindToRenderStep("InvisRenderFix", Enum.RenderPriority.Camera.Value - 1, function()
            if not trueInvisActive or not hrp then return end
            hrp.CFrame = RealLocalCFrame
            if cam.CameraSubject ~= humanoid then
                cam.CameraSubject = humanoid
            end
        end)
        
        DieConnection = humanoid.Died:Connect(function()
            if trueInvisActive then
                CleanUpInvis()
                -- 恢复 UI 状态
                TweenService:Create(ToggleBG, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(80, 80, 80)}):Play()
                TweenService:Create(ToggleCircle, TweenInfo.new(0.3), {Position = UDim2.new(0, 2, 0.5, 0)}):Play()
            end
        end)
        
    else
        -- 关闭隐身
        CleanUpInvis()
        -- UI 动画 (变灰、向左移动)
        TweenService:Create(ToggleBG, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(80, 80, 80)}):Play()
        TweenService:Create(ToggleCircle, TweenInfo.new(0.3), {Position = UDim2.new(0, 2, 0.5, 0)}):Play()
    end
end)
