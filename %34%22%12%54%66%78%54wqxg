local function ApplySettings()
    if not CurrentSettingsTable then return end
    if IsModEnabled then
        for k, v in pairs(CustomStats) do
            if CurrentSettingsTable[k] ~= nil then CurrentSettingsTable[k] = v end
        end
    else
        for k, v in pairs(OriginalStats) do
            if CurrentSettingsTable[k] ~= nil then CurrentSettingsTable[k] = v end
        end
    end
end

