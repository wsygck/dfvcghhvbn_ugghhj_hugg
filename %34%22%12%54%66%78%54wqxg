local function CreateSettingRow(key, value)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, -10, 0, 35)
    Row.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    Row.Parent = ScrollFrame
    Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 6)

    local displayName = TranslationDict[key] or key
    local KeyLabel = Instance.new("TextLabel")
    KeyLabel.Size = UDim2.new(0.65, -10, 1, 0)
    KeyLabel.Position = UDim2.new(0, 10, 0, 0)
    KeyLabel.BackgroundTransparency = 1
    KeyLabel.Text = displayName
    KeyLabel.TextColor3 = Color3.new(0.9, 0.9, 0.9)
    KeyLabel.TextXAlignment = Enum.TextXAlignment.Left
    KeyLabel.Font = Enum.Font.SourceSans
    KeyLabel.TextSize = 14
    KeyLabel.TextWrapped = true
    KeyLabel.Parent = Row

    if type(value) == "boolean" then
        local Toggle = Instance.new("TextButton")
        Toggle.Size = UDim2.new(0, 45, 0, 20)
        Toggle.Position = UDim2.new(1, -55, 0.5, -10)
        Toggle.BackgroundColor3 = value and Color3.fromRGB(60, 200, 100) or Color3.fromRGB(80, 80, 80)
        Toggle.Text = value and "开启" or "关闭"
        Toggle.TextColor3 = Color3.new(1,1,1)
        Toggle.Font = Enum.Font.SourceSansBold
        Toggle.TextSize = 12
        Toggle.Parent = Row
        Instance.new("UICorner", Toggle).CornerRadius = UDim.new(0, 10)

        Toggle.MouseButton1Click:Connect(function()
            CustomStats[key] = not CustomStats[key]
            Toggle.BackgroundColor3 = CustomStats[key] and Color3.fromRGB(60, 200, 100) or Color3.fromRGB(80, 80, 80)
            Toggle.Text = CustomStats[key] and "开启" or "关闭"
            if IsModEnabled then ApplySettings() end
        end)
    else
        local InputBox = Instance.new("TextBox")
        InputBox.Size = UDim2.new(0, 80, 0, 24)
        InputBox.Position = UDim2.new(1, -90, 0.5, -12)
        InputBox.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        InputBox.Text = tostring(value)
        InputBox.TextColor3 = Color3.fromRGB(100, 200, 255)
        InputBox.Font = Enum.Font.Code
        InputBox.TextSize = 14
        InputBox.Parent = Row
        Instance.new("UICorner", InputBox).CornerRadius = UDim.new(0, 4)

        InputBox.FocusLost:Connect(function()
            local newVal = InputBox.Text
            if type(OriginalStats[key]) == "number" then
                newVal = tonumber(newVal) or OriginalStats[key]
                InputBox.Text = tostring(newVal)
            end
            CustomStats[key] = newVal
            if IsModEnabled then ApplySettings() end
        end)
    end
end

LoadBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        LoadBtn.Text = "请先拿在手里!"
        task.wait(1) LoadBtn.Text = "读取手中武器"
        return
    end

    local settingsMod = tool:FindFirstChild("Settings")
    if not settingsMod or not settingsMod:IsA("ModuleScript") then
        LoadBtn.Text = "不是支持的枪械!"
        task.wait(1) LoadBtn.Text = "读取手中武器"
        return
    end

    local success, result = pcall(function() return require(settingsMod) end)
    if not success or type(result) ~= "table" then
        LoadBtn.Text = "读取失败!"
        task.wait(1) LoadBtn.Text = "读取手中武器"
        return
    end

    CurrentSettingsTable = result
    OriginalStats = {}
    CustomStats = {}

    for _, v in ipairs(ScrollFrame:GetChildren()) do
        if v:IsA("Frame") then v:Destroy() end
    end

    local itemCount = 0
    for key, value in pairs(CurrentSettingsTable) do
        if type(value) == "number" or type(value) == "boolean" or type(value) == "string" then
            OriginalStats[key] = value
            CustomStats[key] = value
            CreateSettingRow(key, value)
            itemCount = itemCount + 1
        end
    end
    
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, itemCount * 40)
    LoadBtn.Text = "已成功加载!"
    task.wait(1.5) LoadBtn.Text = "读取手中武器"
end)
