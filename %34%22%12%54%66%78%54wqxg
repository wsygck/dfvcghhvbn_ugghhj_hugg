-- 随机名防检测机制
local function GetRandomName()
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    local str = "hx_"
    for i = 1, 57 do str = str .. string.sub(chars, math.random(1, #chars), math.random(1, #chars)) end
    return str
end

